# 한국관광공사 TourAPI — 공공데이터포털에서 발급받은 "디코딩된" 일반 인증키
KTO_API_KEY=
KTO_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# 카카오 REST API 키 (로컬 검색 — 서버에서만 사용, 프런트 노출 금지)
KAKAO_REST_API_KEY=

# 허용할 프런트 오리진 (쉼표 구분)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177

PORT=4000
