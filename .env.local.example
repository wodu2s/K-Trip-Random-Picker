# 백엔드 API (backend/src/server.js)
VITE_API_BASE_URL=http://localhost:4000

# 카카오 지도 JavaScript 키 (도메인 제한 필요 — REST 키를 넣지 말 것)
VITE_KAKAO_MAP_JS_KEY=

# ---------------------------------------------------------------
# Supabase — 로그인 / 방명록 / 저장한 장소
# Supabase 대시보드 > Project Settings > API 에서 복사
# anon key 는 브라우저에 노출되어도 되는 공개 키이며,
# 실제 접근 제어는 supabase/schema.sql 의 RLS 정책이 담당한다.
# 비워 두면 추천 기능은 그대로 동작하고 로그인·방명록·저장은 비활성화된다.
# ---------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
